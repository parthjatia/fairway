# ---- Global mode ----
# fixture = fully offline with synthetic data (default); live = real Streams / RPC
DATA_MODE=fixture

# ---- Ingest service (services/ingest) ----
INGEST_PORT=8787
INGEST_DB_PATH=./services/ingest/data/fairway.db
# The Stream's security token (optional). When set, ingest verifies QuickNode's HMAC signature
# (x-qn-signature over x-qn-nonce + x-qn-timestamp + body), or accepts x-fairway-token: <token> for curl/local tests.
QN_STREAM_TOKEN=

# ---- Keeper (services/keeper) ----
# dry-run (default, logs intended txs) | local (local validator) | devnet
KEEPER_MODE=dry-run
RPC_URL=http://127.0.0.1:8899
# Path to a THROWAWAY keypair JSON (never a real wallet). Generate with: solana-keygen new -o .keys/score-authority.json
KEEPER_KEYPAIR=./.keys/score-authority.json
KEEPER_BATCH_SIZE=8
KEEPER_MAX_TPS=4

# ---- Frontend (apps/web) ----
# mock (default, no wallet/RPC needed) | live (wallet adapter + SDK)
NEXT_PUBLIC_MODE=mock
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_INGEST_URL=http://127.0.0.1:8787
# Fairway Check (/check, /api/check): when set, the web server answers from this ingest service (live Stream data).
# When empty, it computes the reports from the synthetic fixtures and labels them "Simulated data".
INGEST_URL=
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_POOL_ADDRESS=

# ---- Optional price sources ----
PYTH_HERMES_URL=https://hermes.pyth.network
